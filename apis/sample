item_description
array
add_fields
array
sample_file
string

Example Request
{
  "building_name": "Tower A - Updated",
  "work_done": "Painting completed",
  "location": {
    "address_line1": "Street 1",
    "city": "Mumbai",
    "state": "MH",
    "country": "India"
  },
  "item_description": [
    {
      "sr_no": 1,
      "description": "Paint",
      "quantity": 20,
